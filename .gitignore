.env
.env.*

# Editor / IDE
.vscode/
.idea/

# File sistem operasi
.DS_Store
Thumbs.db
desktop.ini

# Kunci jawaban dosen pada kode acuan (tidak boleh dikirim ke mahasiswa).
# Yang tetap dikirim: README.md, salah_prosedural.py, periksa_pbo.py,
# pyproject.toml, AI_USAGE.md, .gitignore.
/P*-Kode-Acuan/*/src/
/P*-Kode-Acuan/*/tests/
