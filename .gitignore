# Python bytecode / cache
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/
env/

# Cache tools (pytest, mypy, ruff, coverage)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Database lokal
*.db
*.sqlite3

# Rahasia / kredensial
.env
.env.*

# Editor / IDE
.vscode/
.idea/

# File sistem operasi
.DS_Store
Thumbs.db
desktop.ini

# Kunci jawaban dosen (src/ dan tests/) disimpan di repo privat
# PBO-UP-2026-dosen. Pengaman bila tidak sengaja tersalin ke materi.
/P*/materi/src/
/P*/materi/tests/

# Rekap nilai dosen (rahasia, tidak boleh dikirim ke mahasiswa)
Nilai-*.xlsx
~$*.xlsx
